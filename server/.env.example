# Copy to .env for local development. internal/config/config.go is the
# authority; this file mirrors it.
#
# A node normally runs with none of these set — every value has a working
# default, because the node ships inside a desktop application where nobody is
# going to write a config file. These exist for development and for headless
# deployments.

NODE_ENV=development

# Where the SQLite database, the local token and the log live.
# Defaults to <user config dir>/Mediary/node.
NODE_DATA_DIR=

# ── Local HTTP / WebSocket listener ──────────────────────────────────────────
# Loopback by default and it should stay there. TZ §9: the node never accepts
# inbound connections without an explicit action by the user. Binding elsewhere
# requires NODE_TOKEN to be set — the service refuses to start otherwise.
NODE_HTTP_HOST=127.0.0.1
NODE_HTTP_PORT=43711
NODE_HTTP_READ_TIMEOUT=30s
# Zero on purpose: this server streams video and long-lived WebSockets, and a
# write deadline would sever both mid-transfer.
NODE_HTTP_WRITE_TIMEOUT=0s
NODE_HTTP_IDLE_TIMEOUT=120s
NODE_HTTP_SHUTDOWN_TIMEOUT=15s
# Comma-separated. The Vite dev server in development; the packaged app's
# app:// origin in production.
NODE_HTTP_ALLOWED_ORIGINS=http://localhost:5173

# Generated on first start into NODE_DATA_DIR/token. Set it explicitly only for
# a headless node, where nothing can read that file for you.
NODE_TOKEN=

# ── Library ──────────────────────────────────────────────────────────────────
# Pipe-separated, because Windows paths contain colons and semicolons.
NODE_LIBRARY_PATHS=
NODE_LIBRARY_SCAN_INTERVAL=1h
# Off by default: a symlink loop turns a scan into a hang.
NODE_LIBRARY_FOLLOW_SYMLINKS=false

# ── Torrents ─────────────────────────────────────────────────────────────────
# embedded | qbittorrent
NODE_TORRENT_CLIENT=embedded
NODE_TORRENT_DOWNLOAD_DIR=
NODE_TORRENT_LISTEN_PORT=0
NODE_TORRENT_MAX_DOWNLOADS=3
# Opens a port on the user's router. Off unless they ask for it (TZ §9).
NODE_TORRENT_ENABLE_UPNP=false
NODE_TORRENT_EXTERNAL_URL=
NODE_TORRENT_EXTERNAL_USER=
NODE_TORRENT_EXTERNAL_PASSWORD=

# ── Playback ─────────────────────────────────────────────────────────────────
# Looked up on PATH when empty.
NODE_MPV_PATH=
NODE_FFMPEG_PATH=
NODE_TRANSCODE_DIR=
# Off by default: transcoding is expensive and direct play covers most files.
NODE_ENABLE_TRANSCODING=false

# ── Cloud link (optional) ────────────────────────────────────────────────────
# A node without a device token is fully functional offline. Pairing is opt-in.
NODE_CLOUD_URL=http://localhost:8080
NODE_CLOUD_DEVICE_TOKEN=
NODE_CLOUD_TIMEOUT=20s
NODE_CLOUD_SYNC_INTERVAL=5m

# ── Logging ──────────────────────────────────────────────────────────────────
NODE_LOG_LEVEL=debug
NODE_LOG_PRETTY=true
# Defaults to NODE_DATA_DIR/node.log, rotated. This is the file a user attaches
# to a bug report.
NODE_LOG_FILE=
