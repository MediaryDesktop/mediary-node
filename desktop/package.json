{
	"name": "desktop",
	"version": "0.1.0",
	"private": true,
	"//type": "Intentionally NOT \"module\". Electron's main process and its sandboxed preload load as CommonJS; an ESM main fails on `import { app } from 'electron'` because named exports cannot be detected from Electron's built-in CJS module. The renderer is bundled by Vite and unaffected, and .mjs config files stay ESM regardless.",
	"description": "Mediary desktop client: catalog from the cloud and control of the local node in one window.",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build",
		"preview": "electron-vite preview",
		"package": "npm run build && electron-builder --dir",
		"dist": "npm run build && electron-builder",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"lint": "eslint .",
		"arch:check": "node scripts/check-architecture.mjs && eslint src",
		"format": "prettier --write \"{src,electron,scripts}/**/*.{ts,tsx,mjs,scss,css,json,md}\"",
		"format:check": "prettier --check \"{src,electron,scripts}/**/*.{ts,tsx,mjs,scss,css,json,md}\"",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"check": "npm run format:check && npm run arch:check && npm run typecheck && npm run test",
		"api:types": "npm run api:types:node && npm run api:types:cloud",
		"api:types:node": "openapi-typescript ../server/api/openapi.yaml -o src/core/node/schema.gen.ts --root-types",
		"api:types:node:remote": "openapi-typescript http://127.0.0.1:43211/openapi.yaml -o src/core/node/schema.gen.ts --root-types",
		"api:types:cloud": "openapi-typescript ../../mediary-contracts/openapi/cloud.openapi.yaml -o src/core/cloud/schema.gen.ts --root-types"
	},
	"dependencies": {
		"@farfetched/core": "^0.15.0",
		"@tanstack/react-router": "^1.170.32",
		"clsx": "^2.1.1",
		"effector": "^23.4.4",
		"effector-react": "^23.3.0",
		"ofetch": "^1.4.1",
		"patronum": "^2.3.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@mediaryorg/core": "^1.0.5",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.2.0",
		"electron": "^44.0.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^16.0.0",
		"jsdom": "^28.0.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.6",
		"sass": "^1.103.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^7.3.6",
		"vitest": "^4.1.11"
	}
}
