{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023"],
		"types": ["node", "electron-vite/node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"composite": true
	},
	// Plain .mjs scripts are deliberately absent: without allowJs TypeScript
	// ignores them, and a file the compiler ignores but ESLint expects in the
	// project is a parsing error rather than a check.
	"include": ["electron/**/*.ts", "electron.vite.config.ts", "vitest.config.ts"]
}
